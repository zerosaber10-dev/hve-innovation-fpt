      "type": "string",
      "defaultValue": "ghcr.io/zerosaber10-dev/hr-time-leave-agent:latest",
      "metadata": {
        "description": "Container image repository and tag for the HR Copilot App Service."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
