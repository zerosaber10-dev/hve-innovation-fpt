    "botAppId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application / Client ID for the Microsoft Teams Bot registration."
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "SKU name for App Service Plan."
      }
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
