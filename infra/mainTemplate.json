      "properties": {
        "resource": {
          "id": "tickets",
          "partitionKey": {
            "paths": [
              "/ticket_id"
            ],
            "kind": "Hash"
          },
          "indexingPolicy": {
            "indexingMode": "consistent",
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "excludedPaths": [
              {
                "path": "/medical_notes/*"
              },
              {
                "path": "/medical_reason/*"
              },
              {
                "path": "/overtime_calculation_details/*"
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', variables('names').cosmosAccount, 'hr-ticket-store')]"
